{
  "name": "@contractbook/mcp",
  "version": "0.0.1",
  "description": "Model Context Protocol server for the Contractbook API.",
  "keywords": [
    "ai",
    "contractbook",
    "contracts",
    "documents",
    "llm",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Contractbook/mcp.git"
  },
  "bin": {
    "contractbook-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsgo -p tsconfig.json",
    "dev": "vite build --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0-beta.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@typescript/native-preview": "^7.0.0-dev",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.5.0"
}
